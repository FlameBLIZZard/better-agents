{
  "time-machine": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/scripts/time_machine.js",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "auto-formatter": {
    "PreToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/scripts/auto_formatter.js",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "cost-tracker": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "node .agents/scripts/cost_tracker.js",
        "timeout": 10
      }
    ]
  }
}
